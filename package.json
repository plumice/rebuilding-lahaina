{
  "name": "rebuilding-lahaina",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "COPYFILE_DISABLE=1 astro dev",
    "start": "COPYFILE_DISABLE=1 astro dev",
    "build": "COPYFILE_DISABLE=1 astro check && COPYFILE_DISABLE=1 astro build",
    "postbuild": "find dist -name '._*' -delete 2>/dev/null; COPYFILE_DISABLE=1 npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.0",
    "@astrojs/tailwind": "^5.1.0",
    "@tailwindcss/typography": "^0.5.0",
    "astro": "^5.0.0",
    "leaflet": "^1.9.0",
    "medium-zoom": "^1.1.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@types/leaflet": "^1.9.0",
    "autoprefixer": "^10.4.0",
    "pagefind": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
